# Supabase — janus-dev project
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog Analytics (free tier)
# Get from: app.posthog.com → your project → Project Settings
VITE_POSTHOG_KEY=phc_your-key-here
VITE_POSTHOG_HOST=https://app.posthog.com

# Cloudflare Turnstile (signup bot protection)
# Get from: dash.cloudflare.com → Turnstile → your site
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
